        }
      }
    },
    "BlockTube for Safari hides unwanted videos, channels, and comments on YouTube based on the filters you set." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "BlockTube for Safariは、設定したフィルターに基づいて、YouTube上の不要な動画、チャンネル、およびコメントを非表示にします。"
          }
        }
      }
    },
    "BlockTube for Safari Info" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "BlockTube for Safariの情報"
          }
        }
      }
    },
    "Bug Report Page" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "バグ報告ページ"
          }
        }
      }
    },
    "By adding keywords to the filter, videos whose titles contain those keywords are hidden from search results, recommendations, and other YouTube pages." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "フィルターにキーワードを追加すると、タイトルにそのキーワードを含む動画が、検索結果やおすすめなどYouTubeの各ページで非表示になります。"
          }
        }
      }
    },
    "By specifying a channel name or channel ID, all videos from that channel are hidden." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "チャンネル名またはチャンネルIDを指定すると、そのチャンネルのすべての動画が非表示になります。"
          }
        }
      }
    },
